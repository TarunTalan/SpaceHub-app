<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/background_gradient">


        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/communityDetailHeader"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#20262F"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/hr_guideline_top">

            <!-- Back button on the left -->
            <ImageView
                    android:id="@+id/imageView"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:src="@drawable/back_icon"
                    android:contentDescription="@string/cd_back"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="8dp" />

            <!-- Settings / actions on the right -->
            <ImageView
                    android:id="@+id/setting_community"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:src="@drawable/dots_menu"
                    android:contentDescription="@string/more"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginEnd="8dp"
                    app:tint="@android:color/white" />

            <!-- Title centered between back and settings -->
            <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="@string/room_name"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:gravity="center"
                    app:layout_constraintStart_toEndOf="@id/imageView"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    android:layout_marginStart="15dp"
            />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Guideline
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hr_guideline_top"
                app:layout_constraintGuide_percent="0.06"
                android:orientation="horizontal"/>

        <!-- Swipe-to-refresh + scrollable content below the fixed header -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/communityDetailHeader"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/background_gradient">


            <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:background="@drawable/background_gradient">


                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_gradient">


                    <ImageView
                            android:id="@+id/community_banner"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:src="@drawable/banner"
                            android:scaleType="fitXY"
                            android:visibility="gone"
                            android:contentDescription="@string/community_banner_cd"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    <ImageView
                            android:layout_width="80dp"
                            android:layout_height="80dp"
                            android:visibility="gone"
                            android:id="@+id/community_image"
                            android:src="@drawable/default_comm_icon"
                            android:contentDescription="@string/community_image_cd"
                            android:layout_marginBottom="-40dp"
                            app:layout_constraintBottom_toBottomOf="@id/community_banner"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"/>

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/community_name"
                            android:text="@string/community_name"
                            android:visibility="gone"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:fontFamily="@font/roboto_medium"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toBottomOf="@id/community_image"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"/>

                    <TextView
                            android:id="@+id/member_count_tv"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@+id/community_name"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"/>

                    <TextView
                            android:id="@+id/members_tv"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/members"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@+id/member_count_tv"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"/>

                    <TextView
                            android:id="@+id/admin_count_tv"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/zero"
                            android:visibility="gone"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            app:layout_constraintTop_toBottomOf="@+id/community_name"
                            app:layout_constraintStart_toStartOf="@id/admin_tv"/>

                    <TextView
                            android:id="@+id/admin_tv"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/admins"
                            android:visibility="gone"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:layout_marginStart="15dp"
                            app:layout_constraintTop_toBottomOf="@+id/admin_count_tv"
                            app:layout_constraintStart_toEndOf="@id/members_tv"/>

                    <ImageView
                            android:id="@+id/divider_line"
                            android:layout_marginTop="20dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:src="@drawable/line"
                            android:contentDescription="@null"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/members_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>

                    <TextView
                            android:id="@+id/tv_rooms_name"
                            android:layout_marginTop="12dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/chat_rooms"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:fontFamily="@font/roboto_medium"
                            app:layout_constraintTop_toBottomOf="@id/divider_line"
                            app:layout_constraintEnd_toStartOf="@+id/iv_toggle_your_comm"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"/>

                    <ImageView
                            android:id="@+id/iv_toggle_your_comm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_up"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@string/toggle"
                            app:layout_constraintEnd_toStartOf="@+id/guideline_end_2"
                            app:layout_constraintTop_toTopOf="@id/tv_rooms_name"
                            app:layout_constraintBottom_toBottomOf="@id/tv_rooms_name"/>

                    <ProgressBar
                            android:id="@+id/progress"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_rooms_name"
                            android:layout_marginTop="8dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_chat_rooms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minWidth="220dp"
                            android:nestedScrollingEnabled="false"
                            android:layout_marginTop="12dp"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"
                            android:background="@color/transparent"
                            app:layout_constraintEnd_toStartOf="@+id/guideline_end_2"
                            app:layout_constraintTop_toBottomOf="@+id/tv_rooms_name"/>

                    <LinearLayout
                            android:id="@+id/empty_rooms_view"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="24dp"
                            android:paddingBottom="24dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@color/transparent"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/tv_rooms_name"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/chat_plus"
                                android:tint="#CCCCCC"
                                android:contentDescription="@string/no_chat_rooms"
                                android:layout_marginBottom="8dp" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/no_chat_rooms"
                                android:textColor="#CCCCCC"
                                android:textSize="15sp"
                                android:layout_marginTop="0dp"/>

                    </LinearLayout>

                    <!-- Single bottom empty message to show when both chat and voice lists are empty -->
                    <TextView
                        android:id="@+id/empty_bottom_message"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/no_rooms_or_voice"
                        android:textColor="#CCCCCC"
                        android:textSize="15sp"
                        android:gravity="center"
                        android:visibility="gone"
                        android:padding="16dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent" />

                    <!-- Voice rooms header: added below chat rooms section -->

                    <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/volume"
                            android:tint="@color/white"
                            android:contentDescription="@string/speaker"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start" android:id="@+id/imageView2"
                            app:layout_constraintTop_toTopOf="@+id/tv_voice_rooms_name"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_voice_rooms_name"/>

                    <TextView
                            android:id="@+id/tv_voice_rooms_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/voice_rooms"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/roboto_medium"
                            app:layout_constraintTop_toBottomOf="@id/rv_chat_rooms"
                            app:layout_constraintEnd_toStartOf="@+id/iv_toggle_voice_comm"
                            app:layout_constraintStart_toEndOf="@+id/imageView2"/>

                    <ImageView
                            android:id="@+id/iv_toggle_voice_comm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_up"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@string/toggle"
                            app:layout_constraintEnd_toStartOf="@+id/guideline_end_2"
                            app:layout_constraintTop_toTopOf="@id/tv_voice_rooms_name"
                            app:layout_constraintBottom_toBottomOf="@id/tv_voice_rooms_name"/>

                    <ProgressBar
                            android:id="@+id/progress_voice"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_voice_rooms_name"
                            android:layout_marginTop="8dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_voice_rooms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minWidth="220dp"
                            android:nestedScrollingEnabled="false"
                            android:layout_marginTop="10dp"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"
                            android:background="@color/transparent"
                            app:layout_constraintEnd_toStartOf="@+id/guideline_end_2"
                            app:layout_constraintTop_toBottomOf="@+id/tv_voice_rooms_name"/>

                    <TextView
                            android:id="@+id/empty_group_view"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No chat room and voice room yet"
                            android:textColor="#CCCCCC"
                            android:visibility="gone"
                            android:textSize="14sp"
                            android:layout_marginTop="100dp"
                            app:layout_constraintTop_toBottomOf="@id/rv_voice_rooms"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"/>

                    <LinearLayout
                            android:id="@+id/empty_voice_rooms_view"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="24dp"
                            android:paddingBottom="24dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@color/transparent"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/tv_voice_rooms_name"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                    </LinearLayout>

                    <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/guideline_end_2"
                            app:layout_constraintGuide_percent="0.96"
                            android:orientation="vertical"/>
                    <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/guideline_start"
                            app:layout_constraintGuide_percent="0.04"
                            android:orientation="vertical"/>

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>


        <!-- Full-screen loading overlay shown while room resources load -->
        <FrameLayout
                android:id="@+id/loading_overlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:background="#80000000"
                android:clickable="true"
                android:focusable="true">
            <ProgressBar
                    android:id="@+id/loading_progress"
                    style="@android:style/Widget.Material.ProgressBar.Large"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:layout_gravity="center"/>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>