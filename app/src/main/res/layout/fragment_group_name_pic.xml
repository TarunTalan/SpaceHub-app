<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient"
        tools:context=".ui.dashboard.GroupNamePicFragment">

    <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/back_arrow"
            android:src="@drawable/back_icon"
            android:textSize="@dimen/onboarding_button_text_size"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/roboto_regular"
            android:paddingVertical="10dp"
            android:paddingEnd="20dp"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintBottom_toTopOf="@id/guideline_top"/>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_end"
            android:id="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/guideline_top">

        <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="Create Your Group"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/onboarding_title_text_size"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="Your group is where you and your friends hang out and start talking."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="@dimen/onboarding_subtitle_margin_top"
                app:layout_constraintEnd_toEndOf="@+id/tv_title"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintBaseline_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Logo container: stack the logo and an outline overlay so outline always covers the logo -->
    <FrameLayout
            android:id="@+id/grp_pic_frame"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/guideline_comm">

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/grp_pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
        />

        <!-- Outline overlay placed after the image so it is drawn above the image. We will toggle
             this drawable between dashed and solid programmatically to ensure visibility on all devices. -->
        <ImageView
                android:id="@+id/grp_pic_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/outline_circle_dashed_white"
                android:scaleType="fitXY"
                android:contentDescription=""
                android:importantForAccessibility="no"/>

        <ImageView
                android:id="@+id/grp_pic_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:src="@drawable/upload_camera"
                app:layout_constraintTop_toBottomOf="@id/guideline_comm"
                app:layout_constraintEnd_toEndOf="@id/guideline_end"
                app:layout_constraintStart_toStartOf="@id/guideline_start"/>

    </FrameLayout>
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:layout_marginTop="4dp"
            app:layout_constraintEnd_toEndOf="@id/grp_pic_frame"
            app:layout_constraintStart_toStartOf="@id/grp_pic_frame"
            app:layout_constraintTop_toBottomOf="@id/grp_pic_frame"
    />

    <!-- add_icon placed here (after the FrameLayout and Upload label) so it is rendered above the outline -->
    <ImageView
            android:id="@+id/add_icon"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/add_icon"
            android:contentDescription=""
            android:elevation="8dp"
            android:translationZ="12dp"
            app:layout_constraintTop_toTopOf="@id/grp_pic_frame"
            app:layout_constraintEnd_toEndOf="@id/grp_pic_frame"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="-8dp"/>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/grp_pic_frame"
            app:layout_constraintBottom_toTopOf="@id/btn_create_grp"
            app:layout_constraintEnd_toStartOf="@+id/guideline_end"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            android:elevation="5dp"
            android:visibility="gone"
            android:translationZ="5dp">
        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/avatar_row_1"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@id/avatar_row_2">

            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/avatar_1"
                    android:id="@+id/avatar_1"
                    android:contentDescription=""
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toStartOf="@+id/avatar_2"/>

            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/avatar_2"
                    android:id="@+id/avatar_2"
                    android:contentDescription=""
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/avatar_1"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toStartOf="@+id/avatar_3"/>

            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/avatar_3"
                    android:id="@+id/avatar_3"
                    android:contentDescription=""
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/avatar_2"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toStartOf="@+id/avatar_4"/>

            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/avatar_4"
                    android:id="@+id/avatar_4"
                    android:contentDescription=""
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/avatar_3"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:id="@+id/avatar_row_2"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@id/avatar_row_1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/avatar_5"
                    android:id="@+id/avatar_5"
                    android:contentDescription=""
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toStartOf="@+id/avatar_6"/>

            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/avatar_6"
                    android:id="@+id/avatar_6"
                    android:contentDescription=""
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/avatar_5"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toStartOf="@+id/avatar_7"/>

            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/avatar_7"
                    android:id="@+id/avatar_7"
                    android:contentDescription=""
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/avatar_6"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toStartOf="@+id/avatar_8"/>

            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/avatar_8"
                    android:id="@+id/avatar_8"
                    android:contentDescription=""
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/avatar_7"
                    app:layout_constraintHorizontal_bias="0.5"
                    app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/tvGrp_name_grp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/guideline_center"
            app:layout_constraintEnd_toStartOf="@+id/guideline_end"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            android:elevation="5dp"
            android:translationZ="5dp">

        <TextView
                android:id="@+id/tvGrpName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_semibold"
                android:paddingBottom="5dp"
                android:text="Group Name"
                android:textSize="@dimen/label_text_size"
                android:textColor="#FFFFFF"
                app:layout_constraintStart_toStartOf="@+id/etGrpName"
                app:layout_constraintTop_toTopOf="parent"/>

        <EditText
                android:id="@+id/etGrpName"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:maxWidth="@dimen/input_max_width"
                android:maxLength="25"
                android:background="@drawable/edit_text_outline_selector"
                android:fontFamily="@font/roboto_regular"
                android:hint="Enter your Group Name"
                android:inputType="text"
                android:paddingHorizontal="20dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#C6CAD1"
                android:textSize="@dimen/input_text_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvGrpName"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_create_grp"
            android:layout_width="0dp"
            android:layout_height="@dimen/onboarding_button_height"
            android:background="@drawable/rounded_button_bg"
            android:fontFamily="@font/roboto_regular"
            android:text="Next"
            android:textSize="@dimen/onboarding_button_text_size"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:elevation="5dp"
            android:translationZ="5dp"
            app:layout_constraintTop_toBottomOf="@id/tvGrp_name_grp"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            android:layout_marginTop="80dp"/>

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1"/>

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.9"/>

    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.22"
            android:orientation="horizontal"
            android:id="@+id/guideline_comm"/>

    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.95"
            android:id="@+id/guideline_bottom"/>

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.05"/>


    <!-- Decorative Ellipses -->
    <ImageView
            android:id="@+id/ellipse1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            android:layout_marginBottom="75dp"
            app:layout_constraintBottom_toBottomOf="@id/ellipse2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp"/>

    <ImageView
            android:id="@+id/ellipse2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            android:layout_marginBottom="75dp"
            app:layout_constraintBottom_toBottomOf="@+id/ellipse3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp"/>

    <ImageView
            android:id="@+id/ellipse3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guideline_bottom"
            tools:ignore="ContentDescription"
            android:elevation="0dp" app:layout_constraintHorizontal_bias="0.0"/>
    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_center"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>

</androidx.constraintlayout.widget.ConstraintLayout>