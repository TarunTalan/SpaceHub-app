<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient"
        tools:context=".ui.CreateCommunityFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_end"
            android:id="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/guideline_top">

        <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="@string/create_your_community"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/onboarding_title_text_size"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/create_community_subtitle"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="@dimen/onboarding_subtitle_margin_top"
                app:layout_constraintEnd_toEndOf="@+id/tv_title"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintBaseline_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/communityBtnLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintTop_toBottomOf="@id/guideline_comm">

        <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/game_comm"
                android:translationZ="10dp"
                android:layout_marginStart="13dp"
                app:layout_constraintTop_toTopOf="@id/create_own_comm"
                app:layout_constraintStart_toStartOf="@id/create_own_comm"
                app:layout_constraintBottom_toBottomOf="@id/create_own_comm"
                android:layout_marginHorizontal="10dp"/>
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/create_own_comm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:background="@drawable/rounded_button_bg_gray"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/create_my_own"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:elevation="5dp"
                android:translationZ="5dp"
                android:gravity="start|center_vertical"
                android:paddingStart="55dp"
                android:paddingEnd="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>


        <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/game_comm"
                android:layout_marginStart="13dp"
                android:translationZ="10dp"
                app:layout_constraintTop_toTopOf="@id/create_gaming_comm"
                app:layout_constraintStart_toStartOf="@id/create_gaming_comm"
                app:layout_constraintBottom_toBottomOf="@id/create_gaming_comm"
                android:layout_marginHorizontal="10dp"/>
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/create_gaming_comm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:background="@drawable/rounded_button_bg_gray"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/gaming"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:elevation="5dp"
                android:translationZ="5dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingStart="55dp"
                android:paddingEnd="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/create_own_comm" />

        <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/game_comm"
                android:translationZ="10dp"
                android:layout_marginStart="13dp"
                app:layout_constraintTop_toTopOf="@id/create_school_comm"
                app:layout_constraintStart_toStartOf="@id/create_school_comm"
                app:layout_constraintBottom_toBottomOf="@id/create_school_comm"
                android:layout_marginHorizontal="10dp"/>
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/create_school_comm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:background="@drawable/rounded_button_bg_gray"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/school_club"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:elevation="5dp"
                android:translationZ="5dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingStart="55dp"
                android:paddingEnd="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/create_gaming_comm" />

        <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/game_comm"
                android:translationZ="10dp"
                android:layout_marginStart="13dp"
                app:layout_constraintTop_toTopOf="@id/create_friends_comm"
                app:layout_constraintStart_toStartOf="@id/create_friends_comm"
                app:layout_constraintBottom_toBottomOf="@id/create_friends_comm"
                android:layout_marginHorizontal="10dp"/>
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/create_friends_comm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:background="@drawable/rounded_button_bg_gray"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/friends"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:elevation="5dp"
                android:translationZ="5dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingStart="55dp"
                android:paddingEnd="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/create_school_comm" />

        <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/game_comm"
                android:translationZ="10dp"
                android:layout_marginStart="13dp"
                app:layout_constraintTop_toTopOf="@id/create_artists_comm"
                app:layout_constraintStart_toStartOf="@id/create_artists_comm"
                app:layout_constraintBottom_toBottomOf="@id/create_artists_comm"
                android:layout_marginHorizontal="10dp"/>
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/create_artists_comm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:background="@drawable/rounded_button_bg_gray"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/artist"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:elevation="5dp"
                android:translationZ="5dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingStart="55dp"
                android:paddingEnd="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/create_friends_comm" />

        <ImageView
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:src="@drawable/game_comm"
                android:translationZ="10dp"
                android:layout_marginStart="13dp"
                app:layout_constraintTop_toTopOf="@id/create_local_comm"
                app:layout_constraintStart_toStartOf="@id/create_local_comm"
                app:layout_constraintBottom_toBottomOf="@id/create_local_comm"
                android:layout_marginHorizontal="10dp"/>
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/create_local_comm"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:background="@drawable/rounded_button_bg_gray"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/local_community"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:elevation="5dp"
                android:translationZ="5dp"
                android:layout_marginTop="12dp"
                android:gravity="start|center_vertical"
                android:paddingStart="55dp"
                android:paddingEnd="25dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/create_artists_comm" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:elevation="5dp"
            android:translationZ="5dp"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintBottom_toBottomOf="@id/guideline_bottom">

        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_join_community"
                android:layout_width="0dp"
                android:layout_height="@dimen/onboarding_button_height"
                android:background="@drawable/rounded_button_bg"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/join_a_community"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/have_invite_already"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:paddingVertical="5dp"
                android:fontFamily="@font/roboto_regular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:textColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/btn_join_community"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
            android:id="@+id/ellipse4"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_dull"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_marginBottom="10dp"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp" />
    <ImageView
            android:id="@+id/ellipse1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/inverted_ellipse"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp" />
    <ImageView
            android:id="@+id/ellipse2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/inverted_ellipse"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="40dp"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp" />
    <ImageView
            android:id="@+id/ellipse3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/inverted_ellipse"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="80dp"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp" />


    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1" />

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.9" />

    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.25"
            android:orientation="horizontal"
            android:id="@+id/guideline_comm"/>

    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.9"
            android:id="@+id/guideline_bottom"/>

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.05"/>


</androidx.constraintlayout.widget.ConstraintLayout>