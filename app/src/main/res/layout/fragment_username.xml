<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient"
        tools:context=".ui.UsernameFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintBottom_toTopOf="@+id/guideline_top"
            android:id="@+id/constraintLayout2">

        <ImageView
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:paddingVertical="10dp"
                android:paddingStart="-25dp"
                android:id="@+id/back_arrow"
                android:src="@drawable/back_icon"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textColor="#FFFFFF"
                android:fontFamily="@font/roboto_regular"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/skip_1_of_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 2 of 2"
                android:fontFamily="@font/roboto_regular"
                android:textSize="18sp"
                android:textColor="#BFBFBF"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_end"
            android:id="@+id/tvTitleGrp"
            app:layout_constraintTop_toTopOf="@+id/guideline_top">

        <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="What should we call you?"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/onboarding_title_text_size"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="This is how others see you. You can use special character, spaces, whatever."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="@dimen/onboarding_subtitle_margin_top"
                app:layout_constraintEnd_toEndOf="@+id/tv_title"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintBaseline_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Logo container: circular masked ImageView with built-in stroke -->
    <FrameLayout
            android:id="@+id/profile_container"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            android:layout_marginTop="50dp"
            app:layout_constraintVertical_bias="1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/guideline3"
            app:layout_constraintTop_toBottomOf="@+id/tvTitle">

        <ImageView
                android:id="@+id/profile"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/spacehub_name"
                android:src="@drawable/profile_frame"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/circle_clip" />

        <ImageView
                android:id="@+id/profile_stroke"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/circle_stroke"
                android:scaleType="fitXY"
                android:contentDescription=""
                android:elevation="12dp"
                android:translationZ="12dp" />

    </FrameLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/inputContainer"
            android:layout_marginTop="40dp"
            app:layout_constraintTop_toBottomOf="@+id/profile_container"
            app:layout_constraintEnd_toStartOf="@+id/guideline_end"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            android:elevation="5dp"
            android:translationZ="5dp">


        <TextView
                android:id="@+id/tvUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_semibold"
                android:paddingBottom="5dp"
                android:text="User Name"
                android:textSize="@dimen/label_text_size"
                android:textColor="#FFFFFF"
                app:layout_constraintStart_toStartOf="@+id/etUsername"
                app:layout_constraintTop_toTopOf="parent" />

        <EditText
                android:id="@+id/etUsername"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:maxWidth="@dimen/input_max_width"
                android:maxLength="25"
                android:background="@drawable/edit_text_outline_selector"
                android:fontFamily="@font/roboto_regular"
                android:hint="Enter your username"
                android:inputType="textPersonName"
                android:paddingHorizontal="20dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="@dimen/input_text_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvUsername" />

        <TextView
                android:id="@+id/tvUsernameError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/error_margin_top"
                android:fontFamily="@font/roboto_regular"
                android:textColor="#F44336"
                android:textSize="@dimen/error_text_size"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@+id/etUsername"
                app:layout_constraintTop_toBottomOf="@+id/etUsername"
                tools:text="First Name is required" />
        <TextView
                android:id="@+id/tvUsernameInstr"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/error_margin_top"
                android:fontFamily="@font/roboto_regular"
                android:textColor="#C6CAD1"
                android:textSize="@dimen/error_text_size"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="@+id/etUsername"
                app:layout_constraintTop_toBottomOf="@+id/etUsername"
                app:layout_constraintEnd_toStartOf="@+id/tvFirstNameCounter"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/username_instruction" />

        <!-- Character counter for first name  -->
        <TextView
                android:id="@+id/tvFirstNameCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/roboto_regular"
                android:textColor="#C6CAD1"
                android:textSize="12sp"
                android:visibility="visible"
                app:layout_constraintEnd_toEndOf="@+id/etUsername"
                app:layout_constraintTop_toBottomOf="@+id/etUsername"
                tools:text="0 / 50" />


        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_next"
                android:layout_width="0dp"
                android:layout_height="@dimen/onboarding_button_height"
                android:background="@drawable/rounded_button_bg_dull_blue"
                android:enabled="false"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/next"
                android:textSize="@dimen/onboarding_button_text_size"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:elevation="5dp"
                android:translationZ="5dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/etUsername"
                android:layout_marginTop="80dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.1" />

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.9" />

    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.4"
            android:orientation="horizontal"
            android:id="@+id/guideline3"/>

    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.9"
            android:id="@+id/guideline_bottom" />

    <!-- Decorative Ellipses -->
    <ImageView
            android:id="@+id/ellipse1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            android:layout_marginBottom="75dp"
            app:layout_constraintBottom_toBottomOf="@id/ellipse2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp" />

    <ImageView
            android:id="@+id/ellipse2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            android:layout_marginBottom="75dp"
            app:layout_constraintBottom_toBottomOf="@+id/ellipse3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp" />

    <ImageView
            android:id="@+id/ellipse3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guideline_bottom"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp" />

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.08"/>


</androidx.constraintlayout.widget.ConstraintLayout>
