<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <!-- Peer avatar -->
    <ImageView
        android:id="@+id/iv_avatar"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/default_profile"
        android:contentDescription="@string/profile_image"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>

    <!-- Received message bubble (aligned to left) -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/message_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_message_received"
            android:paddingStart="8dp"
            android:paddingEnd="23dp"
            android:paddingVertical="4dp"
            app:layout_constraintStart_toEndOf="@id/iv_avatar"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.7"
    >

        <LinearLayout
                android:id="@+id/inner_vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintStart_toStartOf="parent" app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent">

            <TextView
                    android:id="@+id/tv_sender_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B3FFFFFF"
                    android:fontFamily="@font/roboto_medium"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp"
                    tools:text="Alice sdcdsvdvssvsih"/>

            <!-- container that either shows message text OR file preview -->
            <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                <!-- message text -->
                <TextView
                        android:id="@+id/tv_message"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:ellipsize="end"
                        android:maxWidth="280dp"
                        android:minWidth="70dp"
                        android:fontFamily="@font/roboto_regular"
                        android:breakStrategy="high_quality"
                        android:hyphenationFrequency="full"
                        android:includeFontPadding="false"
                        tools:text="Idcsascsfsfefadfdffgthtyy5ggdddddddddddddddddddgggggggggggggggggggggggggggggggggggg'!"/>

                <!-- file preview row (hidden by default) -->
                <LinearLayout
                    android:id="@+id/file_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iv_file_thumb"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:src="@drawable/ic_file"
                        android:contentDescription="@string/file_preview"
                        android:layout_marginEnd="8dp"/>

                    <TextView
                        android:id="@+id/tv_file_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:fontFamily="@font/roboto_medium" />

                    <LinearLayout
                        android:id="@+id/download_container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginStart="8dp">

                        <ImageView
                            android:id="@+id/iv_download"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:src="@drawable/ic_download"
                            android:contentDescription="@string/file_preview"/>

                        <ProgressBar
                            android:id="@+id/pb_download"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="48dp"
                            android:layout_height="6dp"
                            android:progress="0"
                            android:max="100"
                            android:visibility="gone"
                            android:indeterminate="false"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                </LinearLayout>

            </FrameLayout>

            <TextView
                    android:id="@+id/tv_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#B3FFFFFF"
                    android:textSize="10sp"
                    tools:text="12:31"/>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
