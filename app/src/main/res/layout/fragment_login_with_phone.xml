<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:id="@+id/rootLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient"
        android:focusableInTouchMode="true"
        tools:context=".ui.auth.login.LoginFragment">

    <!-- Root-level percent guidelines (single source of truth) -->
    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/guideline_start"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.08" />

    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/guideline_end"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.92" />

    <!-- Decorative Ellipses moved to be behind content (declared before content so content is drawn above them) -->
    <ImageView
            android:id="@+id/ellipse1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            android:layout_marginBottom="@dimen/ellipse1_margin_bottom"
            app:layout_constraintBottom_toBottomOf="@id/ellipse2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            android:alpha="0.5" />

    <ImageView
            android:id="@+id/ellipse2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            android:layout_marginBottom="@dimen/ellipse2_margin_bottom"
            app:layout_constraintBottom_toBottomOf="@+id/ellipse3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            android:alpha="0.4" />

    <ImageView
            android:id="@+id/ellipse3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            android:paddingBottom="@dimen/ellipse3_padding_bottom"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            android:alpha="0.3" />


    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_title_top"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintEnd_toStartOf="@id/guideline_end"
            android:elevation="6dp"
            android:translationZ="6dp">


        <!-- Title Group -->
        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/titleGroup"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:id="@+id/tvLoginTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_medium"
                    android:text="@string/login"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/title_text_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/margin_subtitle_top"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/welcome_back_nplease_enter_your_details"
                    android:textColor="#C6CAD1"
                    android:textSize="@dimen/subtitle_text_size"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvLoginTitle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Prefix +91 and phone input grouped horizontally -->

        <TextView
                android:id="@+id/tvPhoneLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_semibold"
                android:text="Enter Phone Number"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp"
                app:layout_constraintStart_toStartOf="@+id/phoneInputRow"
                app:layout_constraintBottom_toTopOf="@+id/phoneInputRow"/>
        <LinearLayout
                android:id="@+id/phoneInputRow"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="70dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/titleGroup">



            <TextView
                    android:id="@+id/tvPhonePrefix"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="12dp"
                    android:text="+91"
                    android:textColor="#FFFFFF"
                    android:fontFamily="@font/roboto_regular"
                    android:textSize="@dimen/input_text_size"
                    android:background="@drawable/edit_text_outline_selector"/>

            <EditText
                    android:id="@+id/etPhone"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/edit_text_outline_selector"
                    android:fontFamily="@font/roboto_regular"
                    android:maxWidth="@dimen/input_max_width"
                    android:hint="Enter your phone number"
                    android:paddingStart="12dp"
                    android:textColor="#FFFFFF"
                    android:textColorHint="@color/hint_color"
                    android:textSize="@dimen/input_text_size"
                    android:inputType="phone"
                    android:maxLength="10"
                    tools:ignore="RtlSymmetry"/>

        </LinearLayout>

        <!-- Phone error -->
        <TextView
                android:id="@+id/tvPhoneError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/error_margin_top"
                android:fontFamily="@font/roboto_regular"
                android:textSize="@dimen/error_text_size"
                android:textColor="#F44336"
                android:visibility="invisible"
                app:layout_constraintStart_toStartOf="@id/phoneInputRow"
                app:layout_constraintTop_toBottomOf="@+id/phoneInputRow"
                tools:text="Phone number is required" />

        <!-- Password field for phone login -->
        <TextView
                android:id="@+id/passwordLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_semibold"
                android:paddingBottom="@dimen/label_padding_bottom"
                android:text="@string/enter_password"
                android:textSize="@dimen/label_text_size"
                android:textColor="#FFFFFF"
                app:layout_constraintStart_toStartOf="@+id/passwordLayoutPhone"
                app:layout_constraintBottom_toTopOf="@+id/passwordLayoutPhone"/>

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayoutPhone"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="@dimen/input_height"
                android:layout_marginTop="50dp"
                android:maxWidth="@dimen/input_max_width"
                app:boxBackgroundMode="outline"
                app:boxCollapsedPaddingTop="@dimen/box_collapsed_padding_top"
                app:boxCornerRadiusBottomEnd="@dimen/input_corner_radius"
                app:boxCornerRadiusBottomStart="@dimen/input_corner_radius"
                app:boxCornerRadiusTopEnd="@dimen/input_corner_radius"
                app:boxCornerRadiusTopStart="@dimen/input_corner_radius"
                app:boxStrokeColor="@color/outlined_box_stroke_color"
                app:boxStrokeWidth="@dimen/box_stroke_width"
                app:boxStrokeWidthFocused="@dimen/box_stroke_width"
                app:endIconTint="#C6CAD1"
                app:errorEnabled="false"
                app:helperTextEnabled="false"
                app:hintEnabled="false"
                app:layout_constraintTop_toBottomOf="@id/phoneInputRow"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:startIconDrawable="@drawable/lock"
                app:startIconTint="#C6CAD1">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPasswordPhone"
                    style="@style/AppInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:hint="Enter your password"
                    android:textSize="@dimen/input_text_size"
                    android:inputType="textPassword" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
                android:id="@+id/tvPasswordErrorPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/error_margin_top"
                android:fontFamily="@font/roboto_regular"
                android:textColor="#F44336"
                android:textSize="@dimen/error_text_size"
                android:visibility="visible"
                app:layout_constraintStart_toStartOf="@id/passwordLayoutPhone"
                app:layout_constraintTop_toBottomOf="@id/passwordLayoutPhone"
                tools:text="" />

        <!-- Login button placed below the phone input row and constrained inside the parent ConstraintLayout -->
        <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnLogin"
                android:layout_width="0dp"
                android:layout_height="@dimen/button_height"
                android:background="@drawable/rounded_button_bg"
                android:fontFamily="@font/roboto_regular"
                android:text="@string/log_in"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/button_text_size"
                android:layout_marginTop="50dp"
                app:layout_constraintTop_toBottomOf="@+id/passwordLayoutPhone"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Sign-up link (not have account -> Sign Up) -->
        <LinearLayout
                android:id="@+id/signupGroupPhone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/btnLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

            <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/roboto_regular"
                    android:text="@string/not_have_any_account"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/login_text_size" />

            <TextView
                    android:id="@+id/tvSignupLinkPhone"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/login_margin_start"
                    android:clickable="true"
                    android:focusable="true"
                    android:fontFamily="@font/roboto_regular"
                    android:paddingVertical="@dimen/login_padding_vertical"
                    android:text="@string/sign_up"
                    android:textColor="#2563EB"
                    android:textSize="@dimen/login_text_size" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
