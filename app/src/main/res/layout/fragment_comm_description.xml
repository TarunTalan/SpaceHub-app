<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient"
        tools:context=".ui.dashboard.CommunityDescriptionFragment">

    <ImageView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/back_arrow"
            android:src="@drawable/back_icon"
            android:textSize="@dimen/onboarding_button_text_size"
            android:textColor="#FFFFFF"
            android:fontFamily="@font/roboto_regular"
            android:paddingVertical="10dp"
            android:paddingEnd="20dp"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintBottom_toTopOf="@id/guideline_top" />

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            app:layout_constraintEnd_toStartOf="@+id/guideline_end"
            android:id="@+id/tvTitle"
            app:layout_constraintTop_toTopOf="@+id/guideline_top">

        <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_medium"
                android:text="Create Your Community"
                android:textColor="#FFFFFF"
                android:textSize="@dimen/onboarding_title_text_size"
                android:gravity="center"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_regular"
                android:text="Your community is where you and your friends hang out and start talking."
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:gravity="center"
                android:layout_marginTop="@dimen/onboarding_subtitle_margin_top"
                app:layout_constraintEnd_toEndOf="@+id/tv_title"
                app:layout_constraintStart_toStartOf="@+id/tv_title"
                app:layout_constraintBaseline_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_title" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- Logo container: stack the logo and an outline overlay so outline always covers the logo -->
    <FrameLayout
            android:id="@+id/comm_pic_frame"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:clipToPadding="false"
            android:clipChildren="false"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            app:layout_constraintTop_toBottomOf="@id/guideline_comm">
        <ImageView
                android:id="@+id/img_logo_outline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                android:contentDescription=""
                android:scaleType="fitXY"
                android:adjustViewBounds="false"
                android:layout_margin="-6dp" />

        <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/comm_pic"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:src="@drawable/default_comm_icon"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                app:strokeColor="@color/transparent"
                app:strokeWidth="2dp" />
    </FrameLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/Community_description_grp"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@+id/guideline_center"
            app:layout_constraintEnd_toStartOf="@+id/guideline_end"
            app:layout_constraintStart_toStartOf="@+id/guideline_start"
            android:elevation="5dp"
            android:translationZ="5dp">

        <TextView
                android:id="@+id/tvCommunityDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/roboto_semibold"
                android:paddingBottom="5dp"
                android:text="Community Description"
                android:textSize="@dimen/label_text_size"
                android:textColor="#FFFFFF"
                app:layout_constraintStart_toStartOf="@+id/etCommDescription"
                app:layout_constraintTop_toTopOf="parent" />

        <EditText
                android:id="@+id/etCommDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:maxWidth="@dimen/input_max_width"
                android:maxLength="150"
                android:background="@drawable/edit_text_outline_selector_2"
                android:fontFamily="@font/roboto_regular"
                android:hint="Write description about your Community"
                android:lines="4"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#475569"
                android:textSize="@dimen/input_text_size"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvCommunityDescription" />

        <TextView
                android:id="@+id/tvFirstNameCounter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/roboto_regular"
                android:textColor="#C6CAD1"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="@+id/etCommDescription"
                app:layout_constraintTop_toBottomOf="@+id/etCommDescription"
                tools:text="0 / 100 words" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_create_comm"
            android:layout_width="0dp"
            android:layout_height="@dimen/onboarding_button_height"
            android:background="@drawable/rounded_button_bg"
            android:fontFamily="@font/roboto_regular"
            android:text="Create a Community"
            android:textSize="@dimen/onboarding_button_text_size"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:elevation="5dp"
            android:translationZ="5dp"
            app:layout_constraintTop_toBottomOf="@id/Community_description_grp"
            app:layout_constraintEnd_toEndOf="@id/guideline_end"
            app:layout_constraintStart_toStartOf="@id/guideline_start"
            android:layout_marginTop="80dp" />

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.07" />

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.93" />

    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.22"
            android:orientation="horizontal"
            android:id="@+id/guideline_comm" />

    <androidx.constraintlayout.widget.Guideline
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.95"
            android:id="@+id/guideline_bottom" />

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_top"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.05" />


    <!-- Decorative Ellipses -->
    <ImageView
            android:id="@+id/ellipse1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            android:layout_marginBottom="75dp"
            app:layout_constraintBottom_toBottomOf="@id/ellipse2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp" />

    <ImageView
            android:id="@+id/ellipse2"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            android:layout_marginBottom="75dp"
            app:layout_constraintBottom_toBottomOf="@+id/ellipse3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:ignore="ContentDescription"
            android:elevation="0dp"
            android:translationZ="0dp" />

    <ImageView
            android:id="@+id/ellipse3"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:src="@drawable/ellipse_1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@id/guideline_bottom"
            tools:ignore="ContentDescription"
            android:elevation="0dp" />

    <androidx.constraintlayout.widget.Guideline
            android:id="@+id/guideline_center"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

</androidx.constraintlayout.widget.ConstraintLayout>