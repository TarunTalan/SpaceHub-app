<androidx.constraintlayout.widget.ConstraintLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools" android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/background_gradient">

    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:background="@drawable/background_gradient">


        <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/grpDetailHeader"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:background="#20262F"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/back_icon"
                    android:contentDescription="@string/cd_back"
                    android:paddingVertical="4dp"
                    android:layout_marginStart="6dp"
                    android:paddingEnd="6dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    android:id="@+id/imageView" app:layout_constraintBottom_toBottomOf="parent"/>


            <com.google.android.material.imageview.ShapeableImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:id="@+id/grp_image"
                    android:src="@drawable/default_comm_icon"
                    android:scaleType="centerCrop"
                    android:layout_marginStart="12dp"
                    android:clipToOutline="true"
                    android:contentDescription="@null"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circle"
                    app:layout_constraintStart_toEndOf="@+id/imageView"
                    app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintTop_toTopOf="parent"/>

            <TextView
                    android:id="@+id/tvGroupName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Group Name"
                    android:textColor="@android:color/white"
                    android:textSize="20sp"
                    android:fontFamily="@font/roboto_medium"
                    android:ellipsize="marquee"
                    android:layout_marginHorizontal="10dp"
                    android:marqueeRepeatLimit="marquee_forever"
                    android:singleLine="true"
                    android:gravity="start|center_vertical"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:scrollHorizontally="true"
                    android:focusable="true"
                    android:paddingHorizontal="4dp"
                    android:focusableInTouchMode="true"
                    app:layout_constraintTop_toTopOf="@+id/grp_image"
                    app:layout_constraintEnd_toStartOf="@+id/setting_grp"
                    app:layout_constraintBottom_toBottomOf="@+id/grp_image"
                    app:layout_constraintStart_toEndOf="@+id/grp_image"/>

            <ImageView
                    android:id="@+id/setting_grp"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:src="@drawable/dots_menu"
                    android:layout_marginEnd="6dp"
                    app:tint="@android:color/white"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" app:layout_constraintEnd_toEndOf="parent"/>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Guideline
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/hr_guideline_top"
                app:layout_constraintGuide_percent="0.06"
                android:orientation="horizontal"/>

        <!-- Swipe-to-refresh + scrollable content below the fixed header -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipe_refresh"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toBottomOf="@id/grpDetailHeader"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/background_gradient">


            <androidx.core.widget.NestedScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:background="@drawable/background_gradient">


                <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/background_gradient">


                    <ImageView
                            android:id="@+id/grp_banner"
                            android:layout_width="0dp"
                            android:layout_height="120dp"
                            android:src="@drawable/banner"
                            android:scaleType="fitXY"
                            android:visibility="gone"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>



                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/grp_name"
                            android:text="Group Name"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:visibility="gone"
                            android:fontFamily="@font/roboto_medium"
                            android:layout_marginTop="8dp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"
                            android:layout_marginStart="88dp"/>
                    <TextView
                            android:id="@+id/member_count_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="#ffffff"
                            android:visibility="gone"
                            android:textSize="13sp"
                            android:layout_marginStart="5dp"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                            android:id="@+id/members_tv"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Members"
                            android:visibility="gone"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"
                            android:layout_marginStart="15dp"/>
                    <TextView
                            android:id="@+id/admin_count_tv"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@+id/grp_name"
                            app:layout_constraintStart_toStartOf="@id/admin_tv"/>

                    <TextView
                            android:id="@+id/admin_tv"
                            android:layout_marginTop="4dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Admins"
                            android:textColor="@android:color/white"
                            android:textSize="14sp"
                            android:visibility="gone"
                            android:layout_marginStart="15dp"
                            app:layout_constraintTop_toBottomOf="@+id/admin_count_tv"
                            app:layout_constraintStart_toEndOf="@id/members_tv"/>

                    <ImageView
                            android:id="@+id/divider_line"
                            android:layout_marginTop="20dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:src="@drawable/line"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/members_tv"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"/>


                    <TextView
                            android:id="@+id/tv_rooms_name"
                            android:layout_marginTop="12dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/chat_rooms"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:fontFamily="@font/roboto_medium"
                            app:layout_constraintTop_toBottomOf="@id/divider_line"
                            app:layout_constraintEnd_toStartOf="@+id/iv_toggle_your_comm"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"/>

                    <ImageView
                            android:id="@+id/iv_toggle_your_comm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_up"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@string/toggle"
                            app:layout_constraintEnd_toStartOf="@+id/guideline_end_2"
                            app:layout_constraintTop_toTopOf="@id/tv_rooms_name"
                            app:layout_constraintBottom_toBottomOf="@id/tv_rooms_name"/>

                    <ProgressBar
                            android:id="@+id/progress"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_rooms_name"
                            android:layout_marginTop="8dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_rooms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minHeight="200dp"
                            android:nestedScrollingEnabled="false"
                            android:layout_marginTop="12dp"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"
                            android:background="@color/transparent"
                            app:layout_constraintEnd_toStartOf="@+id/guideline_end_2"
                            app:layout_constraintTop_toBottomOf="@+id/tv_rooms_name"/>

                    <LinearLayout
                            android:id="@+id/empty_rooms_view"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:minHeight="220dp"
                            android:paddingTop="24dp"
                            android:paddingBottom="24dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@color/transparent"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/tv_rooms_name"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/chat_plus"
                                android:tint="#CCCCCC"
                                android:contentDescription="@string/no_chat_rooms"
                                android:layout_marginBottom="8dp" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No rooms yet"
                                android:textColor="@android:color/white"
                                android:textSize="16sp"
                                android:layout_marginTop="0dp"/>

                    </LinearLayout>

                    <!-- Voice rooms section for groups (copied from community fragment) -->

                    <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/volume"
                            android:tint="@color/white"
                            android:contentDescription="@string/speaker"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start" android:id="@+id/imageView2"
                            app:layout_constraintTop_toTopOf="@+id/tv_voice_rooms_name"
                            app:layout_constraintBottom_toBottomOf="@+id/tv_voice_rooms_name"/>

                    <TextView
                            android:id="@+id/tv_voice_rooms_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="Voice Rooms"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:layout_marginStart="6dp"
                            android:fontFamily="@font/roboto_medium"
                            app:layout_constraintTop_toBottomOf="@id/rv_rooms"
                            app:layout_constraintEnd_toStartOf="@+id/iv_toggle_voice_comm"
                            app:layout_constraintStart_toEndOf="@+id/imageView2"/>

                    <ImageView
                            android:id="@+id/iv_toggle_voice_comm"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/arrow_up"
                            android:layout_marginEnd="10dp"
                            android:contentDescription="@string/toggle"
                            app:layout_constraintEnd_toStartOf="@+id/guideline_end_2"
                            app:layout_constraintTop_toTopOf="@id/tv_voice_rooms_name"
                            app:layout_constraintBottom_toBottomOf="@id/tv_voice_rooms_name"/>

                    <ProgressBar
                            android:id="@+id/progress_voice"
                            style="@android:style/Widget.Material.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:visibility="gone"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toBottomOf="@id/tv_voice_rooms_name"
                            android:layout_marginTop="8dp"/>

                    <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_voice_rooms"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:minWidth="220dp"
                            android:nestedScrollingEnabled="false"
                            android:layout_marginTop="10dp"
                            app:layout_constraintStart_toStartOf="@+id/guideline_start"
                            android:background="@color/transparent"
                            app:layout_constraintEnd_toStartOf="@+id/guideline_end_2"
                            app:layout_constraintTop_toBottomOf="@+id/tv_voice_rooms_name"/>

                    <LinearLayout
                            android:id="@+id/empty_voice_rooms_view"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:paddingTop="24dp"
                            android:paddingBottom="24dp"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:background="@color/transparent"
                            android:visibility="gone"
                            app:layout_constraintTop_toBottomOf="@id/tv_voice_rooms_name"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toEndOf="parent">

                        <ImageView
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:src="@drawable/volume"
                                android:tint="#CCCCCC"
                                android:contentDescription="@string/no_voice_rooms"
                                android:layout_marginBottom="8dp" />

                        <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No voice rooms yet"
                                android:textColor="#CCCCCC"
                                android:textSize="15sp"
                                android:layout_marginTop="0dp"/>

                    </LinearLayout>
                    <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/guideline_end_2"
                            app:layout_constraintGuide_percent="0.96"
                            android:orientation="vertical"/>
                    <androidx.constraintlayout.widget.Guideline
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/guideline_start"
                            app:layout_constraintGuide_percent="0.04"
                            android:orientation="vertical"/>

                    <!-- ...existing code... -->
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>



    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Full-screen loading overlay shown while group resources load -->
    <FrameLayout
            android:id="@+id/loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="#80000000"
            android:clickable="true"
            android:focusable="true">
        <ProgressBar
                android:id="@+id/loading_progress"
                style="@android:style/Widget.Material.ProgressBar.Large"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="center"/>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>