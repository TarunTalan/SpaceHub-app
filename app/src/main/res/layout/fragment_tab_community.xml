<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:animateLayoutChanges="true">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCommunity"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:padding="8dp"/>

    <ProgressBar
        android:id="@+id/progress_loader"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center"
        android:visibility="gone"/>

    <!-- Illustration shown when the list is empty -->
    <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center">

        <ImageView
                android:id="@+id/emptyIllustration"
                android:layout_width="250dp"
                android:layout_height="250dp"
                android:layout_gravity="center"
                android:scaleType="centerInside"
                android:src="@drawable/illustration_search"
                android:contentDescription="@null"
                android:visibility="gone"
                app:layout_constraintVertical_bias="0.35"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
        <TextView
                android:layout_marginTop="25dp"
                android:id="@+id/emptyView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/search_community_prompt"
                android:gravity="center"
                android:textSize="18sp"
                android:layout_marginBottom="15dp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@android:color/white"
                android:layout_gravity="center"
                android:visibility="gone"
                app:layout_constraintTop_toBottomOf="@+id/emptyIllustration"
                app:layout_constraintStart_toStartOf="@+id/emptyIllustration"
                app:layout_constraintEnd_toEndOf="@+id/emptyIllustration"/>

        <TextView
                android:id="@+id/emptyView2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/search_community_subtext"
                android:textSize="13sp"
                android:fontFamily="@font/roboto_medium"
                android:textColor="@android:color/white"
                android:layout_gravity="center"
                android:gravity="center"
                android:visibility="gone"
                app:layout_constraintStart_toStartOf="@+id/emptyView"
                app:layout_constraintTop_toBottomOf="@+id/emptyView"
                app:layout_constraintEnd_toEndOf="@+id/emptyView"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom action bar: stays above navigation and appears with a smooth layout transition.
         The fragment can show/hide this view (setVisibility) to animate it into/out of place.
         Place it last in the FrameLayout so it's drawn above the RecyclerView and empty state. -->
    <LinearLayout
        android:id="@+id/bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="bottom|center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:background="#CC121212"
        android:elevation="8dp"
        android:fitsSystemWindows="true">

        <TextView
            android:id="@+id/bottom_bar_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:text="@string/bottom_bar_selected_count" />

        <Button
            android:id="@+id/bottom_bar_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bottom_bar_action_text"
            android:backgroundTint="@color/primary_blue"
            android:textColor="@android:color/white" />

    </LinearLayout>

</FrameLayout>
