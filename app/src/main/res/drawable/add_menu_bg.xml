<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Blue rectangular background -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2563EB"/>
            <size android:width="56dp" android:height="40dp"/>
            <corners android:radius="6dp"/>
        </shape>
    </item>

    <!-- Centered white plus icon on top of the rectangle -->
    <item android:drawable="@drawable/ic_add_white"
          android:gravity="center" />
</layer-list>
